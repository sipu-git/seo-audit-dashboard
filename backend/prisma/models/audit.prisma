model Audit {
  id           String      @id @default(cuid())
  jobId        String      @unique
  url          String
  businessType String
  city         String
  state        String
  status       AuditStatus @default(QUEUED)
  overallScore Int?

  dataSources Json?
  signals     Json?
  analysis    Json?
  note        String?

  reportPath  String?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, createdAt])
  @@index([url, createdAt])
}
