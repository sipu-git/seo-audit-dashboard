{
  "name": "crawlix-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch index.ts",
    "api": "tsx index.ts",
    "api:watch": "tsx watch index.ts",
    "worker": "tsx modules/worker/audit-worker.ts",
    "worker:watch": "tsx watch modules/worker/audit-worker.ts",
    "prisma:generate": "prisma generate --schema prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma",
    "prisma:studio": "prisma studio --schema prisma",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.5.1",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "puppeteer": "^25.16.0",
    "tsx": "^4.23.15",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "prisma": "^6.19.3",
    "typescript": "^5"
  }
}
